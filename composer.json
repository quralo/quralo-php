{
    "name": "quralo/quralo-php",
    "description": "Quralo PHP SDK - Healthcare system integration tools for seamless interoperability with Quralo platform",
    "type": "library",
    "keywords": ["quralo", "healthcare", "hospital", "integration", "interoperability", "sdk", "qr-code", "medical"],
    "license": "MIT",
    "authors": [
        {
            "name": "Quralo Team",
            "email": "developers@quralo.com"
        }
    ],
    "require": {
        "php": ">=5.6",
        "ext-json": "*",
        "ext-gd": "*",
        "aferrandini/phpqrcode": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "Quralo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quralo\\Tests\\": "tests/",
            "Quralo\\Examples\\": "examples/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
